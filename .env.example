# Copy this file to `.env.local` (recommended) or `.env` — Next.js does NOT read `.env.example`.
#
# Hostinger SMTP (SSL on port 465):
#   SMTP_SECURE=true  (required for port 465)

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=billing@iptvheadend.net
SMTP_PASS=your_mailbox_password_here
SMTP_FROM="IPTV Headend <billing@iptvheadend.net>"

# Where you receive the "NEW FORM FILLED" notifications
ADMIN_EMAIL=your-personal-email@example.com

# Optional: canonical site URL for email footer links and payment page CTAs
# NEXT_PUBLIC_SITE_URL=https://iptvheadend.net

# Optional overrides for payment page bases (query params for plan/amount/ref are still appended).
# Defaults: {SITE_URL}/pay/bank and {SITE_URL}/pay/crypto
# BANK_TRANSFER_DETAILS_URL=https://iptvheadend.net/pay/bank
# CRYPTO_DETAILS_URL=https://iptvheadend.net/pay/crypto

# Search engine verification (meta tag). Paste only the token from Google Search Console / Bing Webmaster Tools.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
